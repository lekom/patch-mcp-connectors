            ],
            "additionalProperties": {}
          }
        ],
        "description": "Successful result or a machine-readable tool error."
      },
      "annotations": {
        "title": "Estimate call",
        "readOnlyHint": true,
        "destructiveHint": false,
        "openWorldHint": true
      }
