    {
      "name": "get_call",
      "description": "Get the status and, once terminal, the structured resolution of a call started with place_call. Returns instantly by default. Pass wait_seconds (max 50) to have the server hold the request and return early on any status change \u2014 fewer round trips while a call is in progress. Terminal statuses: completed, no_answer, busy, voicemail, failed, rejected, canceled, declined_recording, opted_out. rejected means safety screening declined the objective before dialing; error.message and resolution.summary explain why. Terminal calls include a `resolution` {outcome: achieved|partially_achieved|not_achieved|no_conversation, summary, commitments[], follow_ups[], key_facts[]} \u2014 read it before the transcript; it is the answer. Completed calls also carry the transcript (may be marked transcript_truncated) and a recording_url the user can listen to (private links expire after ~1 hour). The resolution can lag the terminal status by a few seconds while it is extracted. Calls include the resolved locale, language, voice, and is_public; public calls return token-free listen and recording URLs that remain accessible while public. Use set_call_visibility only when the user explicitly asks to publish or make private. Every call includes a listen_url \u2014 the call page for the user (live audio + transcript while in progress; recording + transcript once ended). ended_by='user' on a canceled call means the user deliberately stopped it from that page \u2014 don't retry. recording_status=processing means the recording is still being prepared by the carrier (typically ready 15\u201390s after the call ends) \u2014 call get_call again, or pass wait_seconds on an already-terminal call to wait for the recording_url.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "call_id": {
            "description": "The id returned by place_call.",
            "type": "string"
          },
          "wait_seconds": {
            "description": "0 (default) = instant status check. Up to 50 = server-side long-poll.",
            "maximum": 50,
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "call_id"
        ],
        "$schema": "http://json-schema.org/draft-07/schema#",
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "$schema": "http://json-schema.org/draft-07/schema#",
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "call_id": {
                "type": "string",
                "description": "Call identifier used with get_call, end_call and set_call_visibility."
              },
              "status": {
                "type": "string",
                "enum": [
                  "queued",
                  "ringing",
                  "in_progress",
                  "completed",
                  "no_answer",
                  "busy",
                  "voicemail",
                  "failed",
                  "rejected",
                  "canceled",
                  "declined_recording",
                  "opted_out"
                ],
                "description": "Current call lifecycle state."
              },
              "to": {
                "type": "string",
                "description": "Destination in E.164 format."
              },
              "callee_name": {
                "anyOf": [
                  {
                    "type": "string",
                    "description": "Recipient display name."
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "language": {
                "type": "string",
                "description": "Resolved call language."
              },
              "locale": {
                "type": "string",
                "description": "Resolved BCP 47 language/locale for this call."
              },
              "voice": {
                "anyOf": [
                  {
                    "type": "string",
                    "description": "Resolved voice identifier."
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "amd_result": {
                "anyOf": [
                  {
                    "type": "string",
                    "description": "Answering-machine detection result."
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "duration_seconds": {
                "type": "number",
                "description": "Connected duration in seconds."
              },
              "is_public": {
                "type": "boolean",
                "description": "Whether the call has a public link."
              },
              "listen_url": {
                "type": "string",
                "description": "URL for the user to listen, read the transcript and stop an active call."
              },
              "resolution": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "outcome": {
                        "type": "string",
                        "enum": [
                          "achieved",
                          "partially_achieved",
                          "not_achieved",
                          "no_conversation"
                        ],
                        "description": "Whether the call objective was met."
                      },
                      "summary": {
                        "type": "string",
                        "description": "User-facing summary of what happened."
                      },
                      "commitments": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "description": "Confirmed commitment."
                        },
                        "description": "What the callee agreed to."
                      },
                      "follow_ups": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "description": "Next action."
                        },
                        "description": "Actions the user still needs to take."
                      },
                      "key_facts": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "description": "Fact learned."
                        },
                        "description": "Useful information from the conversation."
                      },
                      "callee_requested_no_further_calls": {
                        "type": "boolean",
                        "description": "Whether the recipient asked not to be called again."
                      }
                    },
                    "required": [
                      "outcome",
                      "summary",
                      "commitments",
                      "follow_ups",
                      "key_facts",
                      "callee_requested_no_further_calls"
                    ],
                    "additionalProperties": {}
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "transcript": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "sequence": {
                      "type": "number"
                    },
