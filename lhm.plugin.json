                      "type": "string",
                      "enum": [
                        "callee",
                        "agent",
                        "keypad"
                      ],
                      "description": "Speaker or confirmed keypad action."
                    },
                    "text": {
                      "type": "string",
                      "description": "Transcript text."
                    },
                    "at_ms": {
                      "type": "number",
                      "description": "Milliseconds from the transcript timeline origin."
                    }
                  },
                  "required": [
                    "role",
                    "text",
                    "at_ms"
                  ],
                  "additionalProperties": {}
                },
                "description": "Conversation entries; empty before speech is available."
              },
