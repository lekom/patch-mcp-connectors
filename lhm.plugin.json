              },
              "recording_url": {
                "anyOf": [
                  {
                    "type": "string",
                    "description": "Audio URL when ready; private URLs expire."
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "recording_status": {
                "type": "string",
                "enum": [
                  "none",
                  "processing",
                  "available",
                  "failed"
                ],
                "description": "Recording availability."
              },
              "costs": {
                "type": "object",
                "properties": {
                  "currency": {
                    "type": "string",
                    "const": "USD"
                  },
                  "reserved_usage_units": {
                    "anyOf": [
                      {
                        "type": "number",
                        "description": "Reserved usage units; absent on legacy calls."
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "rate_version": {
                    "anyOf": [
                      {
                        "type": "string",
                        "description": "Rate deck version."
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "currency",
                  "rate_version"
                ],
                "additionalProperties": {}
              },
              "error": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "code": {
                        "type": "string",
                        "description": "Call failure code."
                      },
                      "message": {
                        "type": "string",
                        "description": "Call failure explanation."
                      }
                    },
                    "required": [
                      "code",
                      "message"
                    ],
                    "additionalProperties": {}
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "ended_by": {
                "type": "string",
                "description": "Party or system that ended the call."
              },
              "end_reason": {
                "type": "string",
                "description": "Reason the call ended."
              },
              "created_at": {
                "type": "string",
                "description": "ISO 8601 creation time."
              },
              "ended_at": {
                "anyOf": [
                  {
                    "type": "string",
                    "description": "ISO 8601 end time; null while active."
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "call_id",
