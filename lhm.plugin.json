    {
      "name": "list_calls",
      "description": "List the authenticated user's recent calls, newest first, with statuses and outcomes. Useful to recover a lost call_id or review call history. Pass the returned next_cursor as cursor to fetch the next page of older calls. next_cursor is null when no older calls remain. Omit cursor to start at the newest calls. limit defaults to 20 (1\u2013100) on every request.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "limit": {
            "description": "Max rows to return. Default 20.",
            "maximum": 100,
            "minimum": 1,
            "type": "integer"
          },
          "cursor": {
            "description": "Opaque next_cursor from a previous list_calls response. Omit for newest calls.",
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        },
        "$schema": "http://json-schema.org/draft-07/schema#",
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "$schema": "http://json-schema.org/draft-07/schema#",
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "user": {
