    {
      "name": "list_phone_numbers",
      "description": "List this account’s phone numbers, direction availability, publication, and default outbound number. Use source_number_id with place_call to choose an enabled, published outbound number.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "openWorldHint": false
      }
