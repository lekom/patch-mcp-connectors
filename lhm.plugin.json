  "tools": [
    {
      "name": "estimate_call",
      "description": "Check route availability, estimated one-minute usage, and remaining allowance before dialing. Calls in Central America, Europe, North America, and South America. Calls involving any non-US/Canadian number require a paid plan. Uses the verified caller ID and destination to price the route. Uses cached routing data or dialed prefixes without a paid lookup. Does not place a call, send a code, or reserve plan usage. Estimates expire and are rechecked before dialing.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "to": {
            "type": "string",
            "description": "Destination in E.164 format, including country code."
          }
        },
        "required": [
          "to"
        ],
        "$schema": "http://json-schema.org/draft-07/schema#",
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "$schema": "http://json-schema.org/draft-07/schema#",
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "to": {
                "type": "string",
                "description": "Normalized destination in E.164 format."
              },
              "from": {
                "type": "string",
                "description": "Verified caller ID in E.164 format."
              },
              "currency": {
                "type": "string",
                "const": "USD",
                "description": "Billing currency."
              },
              "language": {
                "type": "string",
                "description": "Resolved call language."
              },
              "locale": {
                "type": "string",
                "description": "Resolved BCP 47 language/locale for this call."
              },
              "voice_engine": {
                "type": "string",
                "description": "Voice provider used for this quote."
              },
              "one_minute_usage_percent": {
                "anyOf": [
                  {
                    "type": "number",
                    "description": "Estimated monthly allowance percentage for a one-minute call; null on the free plan."
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "estimated_total_cents_at_one_minute": {
                "type": "string",
                "description": "Estimated combined provider cost for one minute."
              },
              "estimated_telnyx_cents_at_one_minute": {
                "type": "string",
                "description": "Estimated carrier cost for one minute."
              },
              "estimate_exclusions": {
                "type": "array",
                "items": {
                  "type": "string",
                  "description": "Excluded cost category."
                },
                "description": "Costs not included in this estimate."
              },
              "max_duration_minutes": {
                "anyOf": [
                  {
                    "type": "number",
                    "description": "Free-call duration cap; null for paid calls."
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "usage_left_percent": {
                "type": "number",
                "description": "Remaining plan usage percentage."
              },
              "rate_version": {
                "type": "string",
                "description": "Rate deck version."
              },
              "rate_expires_at": {
                "anyOf": [
                  {
                    "type": "string",
                    "description": "ISO 8601 rate expiry; null if expiry is quote-specific."
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "quote_expires_at": {
                "type": "string",
                "description": "ISO 8601 quote expiry."
              },
              "routing_basis": {
                "type": "string",
                "description": "Evidence used to price the route."
              },
              "provider_cost_is_customer_charge": {
                "type": "boolean",
                "description": "Whether provider costs count toward paid usage."
              },
              "message": {
                "type": "string",
                "description": "Allowance and route guidance."
              }
            },
            "required": [
              "to",
              "from",
              "currency",
              "language",
              "locale",
              "voice_engine",
              "one_minute_usage_percent",
              "estimated_total_cents_at_one_minute",
              "estimated_telnyx_cents_at_one_minute",
              "estimate_exclusions",
              "max_duration_minutes",
              "usage_left_percent",
              "rate_version",
              "rate_expires_at",
              "quote_expires_at",
